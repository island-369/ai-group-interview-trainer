# 复制为 .env 后按需修改；.env 已被 .gitignore 排除
# LLM_PROVIDER 留空时自动推断：有 LLM_API_KEY 走真实接口，否则 mock（无需任何密钥即可本地跑通）
LLM_PROVIDER=
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL_STRONG=glm-4-plus
LLM_MODEL_LIGHT=glm-4-flash
SESSION_TOKEN_BUDGET=400000

# 语音层（docs/06）：需 uv pip install -e ".[voice]" 并下载 ASR 模型；缺任一自动降级纯文字
VOICE_TTS_PROVIDER=edge
VOICE_ASR_PROVIDER=local

# DeepSeek 官方示例
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_MODEL_STRONG=deepseek-flash
# LLM_MODEL_LIGHT=deepseek-flash
